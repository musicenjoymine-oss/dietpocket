# Optional: enables real AI coach replies. Without it the app uses a local rule-based coach.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: enables cloud sync. Without them the app works local-only.
# Supabase Dashboard -> Project Settings -> API. The anon key is public by design;
# data is protected by the Row Level Security policies in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
